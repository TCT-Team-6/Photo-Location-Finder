modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[objectStorage]
defaultBucketID = "replit-objstore-73f6658c-1413-45f7-8d2b-da8fab2b7371"

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
DEFAULT_OBJECT_STORAGE_BUCKET_ID = "DeafeningAgonizingSuperuser"
